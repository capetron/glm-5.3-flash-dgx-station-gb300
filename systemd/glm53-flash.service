# GLM-5.3-Flash, nvidia NVFP4 checkpoint, vLLM TP1 on a DGX Station GB300, native 1M context, port 8888.
# No MTP: it fails to load with this checkpoint in this vLLM build.
# Edit the two -v host paths if your weights or cache live elsewhere.
[Unit]
Description=GLM-5.3-Flash NVFP4 (nvidia) on vLLM, GB300, port 8888
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# a crash loop (e.g. an OOM on every start) stops after 3 tries in an hour instead of hammering the box
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/glm53-flash-prestart.sh
ExecStart=/usr/bin/docker run --name glm53-flash \
  --network host --ipc host --shm-size 32g --gpus all \
  --ulimit memlock=-1:-1 --ulimit nofile=1048576 \
  --log-opt max-size=200m --log-opt max-file=3 \
  -v /srv/models/GLM-5.3-Flash-NVFP4:/model:ro \
  -v /srv/vllm-cache:/root/.cache/vllm -e VLLM_CACHE_ROOT=/root/.cache/vllm \
  -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1 \
  -e TORCH_CUDA_ARCH_LIST=10.3a -e FLASHINFER_CUDA_ARCH_LIST=10.3a -e CUTE_DSL_ARCH=sm_103a \
  --entrypoint vllm \
  vllm/vllm-openai@sha256:8e138f4eac3a39cbab573e11cebe7cadacc939745003d0fd2b460b5576c1015b \
  serve /model --served-model-name glm-5.3-flash --trust-remote-code \
    --tensor-parallel-size 1 --max-model-len 1048576 --max-num-seqs 256 \
    --enable-chunked-prefill --enable-prefix-caching --gpu-memory-utilization 0.94 \
    --enable-auto-tool-choice --tool-call-parser glm47 --reasoning-parser glm45 \
    --host 0.0.0.0 --port 8888
ExecStop=/usr/bin/docker stop -t 60 glm53-flash
Restart=on-failure
RestartSec=60
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
